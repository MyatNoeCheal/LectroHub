# Harden PHP session cookies (applies when PHP runs as an Apache module,
# e.g. XAMPP). Ignored harmlessly otherwise.
<IfModule mod_php.c>
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Lax
    php_value session.use_strict_mode 1
</IfModule>
<IfModule mod_php8.c>
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Lax
    php_value session.use_strict_mode 1
</IfModule>
